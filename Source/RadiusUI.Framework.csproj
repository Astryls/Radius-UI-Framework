<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RadiusUI.Framework</AssemblyName>
    <RootNamespace>RadiusUI.Framework</RootNamespace>
    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <!-- PUBLISH_CHECKLIST 5/6: no debug symbols ship. OutputPath is ..\Assemblies\ for EVERY
       configuration, so a Release build used to drop RadiusUI.Framework.pdb straight into the
       folder that gets uploaded - inside a Keep folder, which is exactly how the checklist says
       a .pdb ships by accident. .gitignore hides it (*.pdb), so it is invisible in git status
       too. Setting DebugType none makes that structural rather than a manual delete each time.
       Debug builds keep their symbols so stack traces still carry line numbers in development. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- 2026-08-17 21:3x (Quest Menu session): the RadiusIcon-era files are ACTIVE again.
       Icons/IconSet.cs was rewritten as the partial core these generated accessors expect:
       it provides internal Reg(path, tier), the alias table (aliases.json), string-path
       Get() for dynamic lookups, and the alias-backed ordered sets (SquadEmblems x8,
       ReminderSlots x8). The earlier non-partial path-based IconSet that prompted the
       exclusion below is gone - RadiusIcon's tier-in-the-type design won. No regeneration
       needed; gen_iconset.sh output is compatible as-is. -->
